  "rules": [
    {
      "id": "ARCH24",
      "phase": "plan_schema",
      "severity": "ERROR",
      "check": "Exactly 24 ordered copper layers; 12S/8G/4P; role[i]==role[25-i]; every S references an adjacent G; each physical copper/insulator mirror pair must be tied to fabricator symmetry tolerances before qualification."
    },
    {
      "id": "NO_DIRECT_REMAP",
      "phase": "all",
      "severity": "ERROR",
      "check": "No old_layer_to_new_layer execution map, deleted net, net renaming or arbitrary deep blind preservation may be inferred from this architecture document."
    },
    {
      "id": "INPUTS_FAIL_CLOSED",
      "phase": "qualification_and_release",
      "severity": "BLOCKED",
      "check": "Each gate checks only its declared required inputs. Missing qualified geometry/limits blocks coupling or manufacturing qualification, not architecture arithmetic or explicitly hypothetical geometric experiments. Release requires every applicable field source-linked, reviewed and revision-bound. Non-applicable fields need an approved not-used record; null is not a waiver."
    },
    {
      "id": "PAIR_SAME_LAYER",
      "phase": "geometry",
      "severity": "ERROR",
      "check": "This candidate chooses same-layer edge-coupled differential routing: P and N occupy the same signal layer along every coupled section; transitions use matching approved macro ID/order. Splitting P/N across an S-S pair violates this project strategy. This is not a claim that properly designed broadside differential transmission lines are universally invalid."
    },
    {
      "id": "S_S_ENUMERATION",
      "phase": "geometry",
      "severity": "ERROR",
      "check": "Enumerate inter-net cross-layer interactions for layers 6/7,12/13,18/19 including escape, bends, tuning and pads; record nearest XY edge distance, angle, parallel projected overlap, actual z separation and qualified-envelope ID. Never use plane fill or nominal orthogonality as a substitute for enumeration."
    },
    {
      "id": "S_S_ENVELOPE",
      "phase": "routing_qualification",
      "severity": "BLOCKED_OR_ERROR",
      "check": "For every S-S interaction, compare geometry to its SI-qualified envelope tied to this cured stackup, width/gap and interface. Missing envelope/threshold -> BLOCKED; out-of-envelope -> ERROR unless bounded exception has approving SI evidence."
    },
    {
      "id": "S_S_ORIENTATION",
      "phase": "planning",
      "severity": "REVIEW",
      "check": "Prefer orthogonal predominant directions in each S-S pair and avoid broadside co-parallel trunks; 90 degrees is a routing preference, not an SI pass. Local diagonal turns, serpentine and connector fanout remain subject to S_S_ENVELOPE. Prefer region separation if both neighbors need parallel trunk directions."
    },
    {
      "id": "REF_PLANE_CONTINUITY",
      "phase": "geometry_and_si",
      "severity": "BLOCKED_OR_ERROR",
      "check": "For every high-speed path, its inflated XY corridor must lie in connected GND copper on the designated reference layer; subtract actual antipads/voids/plane splits. Corridor/void margin comes from approved SI inputs. Unknown margin -> BLOCKED; geometric failure -> ERROR."
    },
    {
      "id": "GROUND_LAYER_USE",
      "phase": "geometry",
      "severity": "ERROR",
      "check": "G layers contain GND plane/stitches, with non-GND copper limited to registered compact escape landing/bridge exceptions. General signal/power routing on G layers is forbidden; local holes may not sever return corridors."
    },
    {
      "id": "APPROVED_VIA_MACRO",
      "phase": "geometry_and_fabrication",
      "severity": "BLOCKED_OR_ERROR",
      "check": "Every via belongs to a whole approved macro/process table. Matching a candidate layer pair alone is insufficient. Arbitrary blind depth, automatically generated 2+ stages, unqualified skip via or stacked-on-buried via -> ERROR."
    },
    {
      "id": "HDI_GROUND_LANDING",
      "phase": "geometry_and_fabrication",
      "severity": "ERROR",
      "check": "For L1->L3 or L24->L22 signal escape, the middle G-layer landing/bridge is the signal net, isolated by approved antipad; verify capture/target pads, registration, offset, fill/cap and manufacturing stages. Coincident XY is stacked HDI and requires explicit macro approval."
    },
    {
      "id": "RETURN_TRANSITION",
      "phase": "geometry_and_si",
      "severity": "BLOCKED_OR_ERROR",
      "check": "Every signal reference change has approved nearby return macro actually connecting all old/new GND planes. Merely a nearby GND-labelled pad or disconnected island cannot pass."
    },
    {
      "id": "BARREL_STUBS",
      "phase": "geometry_and_si",
      "severity": "BLOCKED_OR_ERROR",
      "check": "Compute all unused barrel lengths from actual z coordinates and electrical taps, including core stubs and dual-sided drill tolerance. Compare worst-case residual stub to qualified limits; missing actual stackup/backdrill data -> BLOCKED."
    },
    {
      "id": "BACKDRILL_CLEARANCE",
      "phase": "fabrication",
      "severity": "ERROR",
      "check": "Check swept oversized drill volume plus registration/depth tolerance against protected copper on every crossed layer; do not erase needed tap, fill/cap requirement or return connection."
    },
    {
      "id": "INDEPENDENT_PWR_NETS",
      "phase": "geometry_and_pdn",
      "severity": "ERROR",
      "check": "Keep all independently fused SSD output nets and other rails isolated; neither P-layer consolidation nor copper fill may merge nets. Current, thermal and dynamic PDN evidence is required separately."
    },
    {
      "id": "RELEASE_GATES",
      "phase": "release",
      "severity": "BLOCKED",
      "check": "Real component/ballmap/PDG + routed connectivity/DRC + approved DFM stack/vias + channel SI + PDN/thermal + mechanical + assembly/reliability evidence must all pass; no individual script can set manufacturing_ready."
    }
  ],
