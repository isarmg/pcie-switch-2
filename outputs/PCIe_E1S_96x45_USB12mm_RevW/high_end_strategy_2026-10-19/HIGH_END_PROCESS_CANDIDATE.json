  "machine_checkable_constraints": [
    {
      "id": "ROLE_ARITHMETIC",
      "gate": "architecture",
      "check": "N equals role count and top+core+bottom; symmetric roles; each S has adjacent G; compare S-S list",
      "can_run_without_fab": true
    },
    {
      "id": "GEOMETRY_TRIAL_ONLY",
      "gate": "hypothetical_geometry",
      "check": "Tag all trial outputs with profile hash and GEOMETRY_ONLY; no fabrication or impedance PASS inference",
      "can_run_without_fab": true
    },
    {
      "id": "SAME_LAYER_EDGE_PAIR",
      "gate": "geometry",
      "check": "P/N route in same layer and through matching macros as project strategy; no split pair to create fake capacity",
      "can_run_without_fab": true
    },
    {
      "id": "REFERENCE_REGION",
      "gate": "geometry",
      "check": "No trace over split/void/isolated landing-pad clearances of designated reference; return-via macro reserved at transitions",
      "can_run_without_fab": true
    },
    {
      "id": "SS_COUPLING",
      "gate": "SI_qualification",
      "check": "24L adjacent S-S regions report overlap length, lateral offset, angle, h-reference and h-signal; restrict long parallel routes until field-solved crosstalk budget exists. 28L has no adjacent S-S, but still requires SI.",
      "missing_input_result": "BLOCKED_QUALIFICATION_NOT_GEOMETRY"
    },
    {
      "id": "NO_DEEP_BLIND_REUSE",
      "gate": "geometry",
      "check": "Old 3837 via coordinates are historical obstacles only, not mandatory endpoints; replace net endpoint connectivity with approved-or-trial short macros; never map 907 deep 100um drills into new depth",
      "can_run_without_fab": true
    },
    {
      "id": "VIA_GRAPH",
      "gate": "geometry",
      "check": "Each macro is explicit single-adjacent-step graph; signal landing on G layer remains isolated from GND. Detect same-XY consecutive count, skip layers, stack-on-buried and net shorts.",
      "can_run_without_fab": true
    },
    {
      "id": "DEPTH_AND_FAB",
      "gate": "manufacturing_qualification",
      "check": "Use effective laser depth, bottom/entry diameter convention, registration, pressed dimensions and approved lamination sequence. Two-high trial limit is not reliability proof.",
      "missing_input_result": "BLOCKED_QUALIFICATION_NOT_GEOMETRY"
    },
    {
      "id": "BACKDRILL",
      "gate": "manufacturing_and_SI_qualification",
      "check": "Check every drilled layer keepout and must-not-cut layer, tool depth tolerance and residual stub; trial geometry does not generate release NC file.",
      "missing_input_result": "BLOCKED_QUALIFICATION_NOT_GEOMETRY"
    },
    {
      "id": "RELIABILITY",
      "gate": "release",
      "check": "Matched topology/material coupon with reflow resistance monitoring plus agreed accelerated thermal/moisture testing; continuity/DC DRC and microsection alone insufficient",
      "missing_input_result": "BLOCKED_RELEASE"
    },
    {
      "id": "ENDPOINTS",
      "gate": "functional_release",
      "check": "Actual CPU/switch ballmap, E1.S connector footprint and electrical model verified; placeholder routing is capacity experiment only",
      "missing_input_result": "BLOCKED_RELEASE"
    },
    {
      "id": "POWER_ISOLATION",
      "gate": "geometry_and_PDN",
      "check": "Keep 12 eFuse outputs electrically distinct; 4 power-layer budget is not current or thermal signoff; no fine-line shortcut for 300W budget",
      "can_run_geometry_without_fab": true
    }
  ],
  "decision": "Compare 28-HDI4 versus 24-HDI4 on true endpoint routing, SI/PDN, total thickness and qualified yield; select minimum necessary layers after evidence. 20L and full anylayer are not current priorities."
}
